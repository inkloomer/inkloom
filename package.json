{
  "name": "inkloom",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "animation:pages": "node scripts/validate-typography.mjs && node scripts/capture-remotion-pages.mjs",
    "animation:audit-layout": "node scripts/validate-typography.mjs && node scripts/capture-remotion-pages.mjs",
    "animation:gate": "node scripts/validate-typography.mjs && node scripts/validate-animation-styles.mjs && node scripts/validate-animation-structure.mjs && node scripts/capture-remotion-pages.mjs",
    "animation:styles": "node scripts/validate-typography.mjs && node scripts/validate-animation-styles.mjs && node scripts/validate-animation-structure.mjs",
    "animation:typography": "node scripts/validate-typography.mjs",
    "animation:typography:contacts": "node scripts/audit-typography-contact-sheets.mjs",
    "animation:publish-video": "node scripts/validate-typography.mjs && node scripts/publish-remotion-media.mjs --video",
    "animation:publish-avif": "node scripts/validate-typography.mjs && node scripts/publish-remotion-media.mjs --format avif",
    "animation:publish-webp": "node scripts/validate-typography.mjs && node scripts/publish-remotion-media.mjs --format webp",
    "animation:compare-av1": "node scripts/publish-remotion-media.mjs",
    "siyuan:embed-avif": "node scripts/embed-siyuan-avif.mjs --format avif",
    "siyuan:embed-scene": "node scripts/embed-siyuan-scene.mjs",
    "siyuan:embed-webp": "node scripts/embed-siyuan-avif.mjs --format webp",
    "test:browser": "vitest run --browser",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@astrojs/starlight": "^0.41.6",
    "@catppuccin/starlight": "^2.1.0",
    "@remotion/effects": "4.0.503",
    "@remotion/fonts": "4.0.503",
    "@remotion/player": "4.0.503",
    "@remotion/rough-notation": "4.0.503",
    "@remotion/transitions": "4.0.503",
    "astro": "^7.1.6",
    "lucide-react": "1.28.0",
    "lxgw-wenkai-mono-gb-screen-webfont": "1.0.1",
    "neotraverse": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.503",
    "remotion-animated": "2.2.0",
    "remotion-bits": "0.2.0",
    "sharp": "^0.35.3",
    "starlight-auto-sidebar": "^0.4.0"
  },
  "devDependencies": {
    "@astrojs/starlight-tailwind": "5.0.0",
    "@remotion/bundler": "4.0.503",
    "@remotion/renderer": "4.0.503",
    "@remotion/tailwind-v4": "4.0.503",
    "@tailwindcss/vite": "4.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.0",
    "vitest": "4.1.10"
  }
