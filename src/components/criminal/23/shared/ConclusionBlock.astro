---
// src/components/ConclusionBlock.astro
interface Props {
  type: '想象竞合' | '牵连犯' | '独立既遂' | '不构成犯罪' | '共犯既遂';
  label: string;
}

const { type, label } = Astro.props;

const config = {
  想象竞合: { class: 'conclusion-purple', icon: '⚖️' },
  牵连犯: { class: 'conclusion-orange', icon: '🔗' },
  独立既遂: { class: 'conclusion-green', icon: '✓' },
  共犯既遂: { class: 'conclusion-teal', icon: '👥' },
  不构成犯罪: { class: 'conclusion-red', icon: '✗' }
};

const theme = config[type] || config.独立既遂;
---
<div class={`conclusion-block-bubble answer-node ${theme.class}`}>
  <span class="conclusion-icon">{theme.icon}</span>
  <span class="conclusion-label"><strong class="conclusion-type">{type}</strong>：{label}</span>
</div>

<style is:global>
  /* ==================== CONCLUSION BLOCK MINIMAL PILL ==================== */
  .conclusion-block-bubble {
    margin-top: 6px !important;
    padding: 8px 10px !important;
    border-radius: 4px !important;
    font-size: 11.5px !important;
    font-weight: 600 !important;
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    transition: background-color 0.15s ease !important;
    border: 1px solid transparent !important;
    box-sizing: border-box !important;
    user-select: none !important;
  }

  .conclusion-icon {
    font-size: 12px !important;
    line-height: 1 !important;
  }

  .conclusion-label {
    line-height: 1.25 !important;
  }

  .conclusion-type {
    font-weight: 700 !important;
  }

  /* Flat clean minimalist background highlights in dark mode */
  
  /* 1. Purple */
  .conclusion-purple {
    background-color: rgba(167, 139, 250, 0.08) !important;
    border-color: rgba(167, 139, 250, 0.25) !important;
    color: #c084fc !important;
  }
  .conclusion-purple:hover {
    background-color: rgba(167, 139, 250, 0.12) !important;
  }
  [data-theme="light"] .conclusion-purple {
    background-color: #f5f3ff !important;
    border-color: #ddd6fe !important;
    color: #6d28d9 !important;
  }

  /* 2. Orange */
  .conclusion-orange {
    background-color: rgba(249, 115, 22, 0.08) !important;
    border-color: rgba(249, 115, 22, 0.25) !important;
    color: #fdba74 !important;
  }
  .conclusion-orange:hover {
    background-color: rgba(249, 115, 22, 0.12) !important;
  }
  [data-theme="light"] .conclusion-orange {
    background-color: #fff7ed !important;
    border-color: #ffedd5 !important;
    color: #c2410c !important;
  }

  /* 3. Green */
  .conclusion-green {
    background-color: rgba(52, 211, 153, 0.08) !important;
    border-color: rgba(52, 211, 153, 0.25) !important;
    color: #6ee7b7 !important;
  }
  .conclusion-green:hover {
    background-color: rgba(52, 211, 153, 0.12) !important;
  }
  [data-theme="light"] .conclusion-green {
    background-color: #ecfdf5 !important;
    border-color: #a7f3d0 !important;
    color: #047857 !important;
  }

  /* 4. Teal */
  .conclusion-teal {
    background-color: rgba(20, 184, 166, 0.08) !important;
    border-color: rgba(20, 184, 166, 0.25) !important;
    color: #5eead4 !important;
  }
  .conclusion-teal:hover {
    background-color: rgba(20, 184, 166, 0.12) !important;
  }
  [data-theme="light"] .conclusion-teal {
    background-color: #f0fdfa !important;
    border-color: #99f6e4 !important;
    color: #0d9488 !important;
  }

  /* 5. Red */
  .conclusion-red {
    background-color: rgba(239, 68, 68, 0.08) !important;
    border-color: rgba(239, 68, 68, 0.25) !important;
    color: #fca5a5 !important;
  }
  .conclusion-red:hover {
    background-color: rgba(239, 68, 68, 0.12) !important;
  }
  [data-theme="light"] .conclusion-red {
    background-color: #fef2f2 !important;
    border-color: #fecdd3 !important;
    color: #be123c !important;
  }
</style>
