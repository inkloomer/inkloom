---
// src/components/ActorColumn.astro
interface Props {
  actor: '甲' | '乙' | '丙';
  title: string;
}
const { actor, title } = Astro.props;
const colorMap = {
  甲: { border: 'rgba(59, 130, 246, 0.25)', dot: '#3b82f6' },
  乙: { border: 'rgba(168, 85, 247, 0.25)', dot: '#a855f7' },
  丙: { border: 'rgba(34, 197, 94, 0.25)', dot: '#22c55e' }
};
const colors = colorMap[actor] || colorMap['甲'];
---
<div class="actor-analysis-column" data-actor={actor} style={`--actor-border-color: ${colors.border};`}>
  <div class="actor-column-header">
    <span class="actor-header-dot" style={`background-color: ${colors.dot};`}></span>
    <span class="actor-header-text">{actor}</span>
    <span class="actor-header-title">{title}</span>
  </div>
  <div class="actor-column-content">
    <slot />
  </div>
</div>

<style is:global>
  /* ==================== ACTOR COLUMN MINIMALIST CAPSULE ==================== */
  .actor-analysis-column {
    display: flex !important;
    flex-direction: column !important;
    background-color: var(--sl-color-bg-sidebar) !important;
    border: 1px solid var(--sl-color-hairline) !important;
    border-radius: 8px !important;
    padding: 12px !important;
    box-sizing: border-box !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  }

  .actor-analysis-column:hover {
    border-color: var(--actor-border-color) !important;
  }

  .actor-column-header {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    color: var(--sl-color-text) !important;
    border-bottom: 1px dashed var(--sl-color-hairline) !important;
    padding-bottom: 6px !important;
    margin-bottom: 8px !important;
  }

  .actor-header-dot {
    width: 6px !important;
    height: 6px !important;
    border-radius: 50% !important;
    display: inline-block !important;
  }

  .actor-header-text {
    font-size: 14px !important;
    font-weight: 700 !important;
  }

  .actor-header-title {
    font-size: 11px !important;
    color: var(--sl-color-text-muted) !important;
    font-weight: 400 !important;
  }

  .actor-column-content {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }
</style>
