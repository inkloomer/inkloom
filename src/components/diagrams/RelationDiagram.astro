---
/**
 * 通用关系图组件
 * 通过传入节点、连线、箭头数据，渲染 SVG 关系图
 * 所有颜色使用 Starlight CSS 变量，自动适配主题
 */

export interface Node {
  id: string;
  label: string;
  x: number;
  y: number;
}

export interface Edge {
  from: string; // 对应 Node.id
  to: string;   // 对应 Node.id
  label?: string;
  dashed?: boolean;
  curve?: 'up' | 'down'; // 同向边弯曲偏移，避免重叠
}

export interface Arrow {
  fromX: number;
  fromY: number;
  toX: number;
  toY: number;
  label?: string;
}

export interface Props {
  nodes: Node[];
  edges: Edge[];
  arrows?: Arrow[];
  width?: number;
  height?: number;
}

const { nodes, edges, arrows = [], width = 520, height = 380 } = Astro.props;

function getNodeById(id: string) {
  return nodes.find((n) => n.id === id)!;
}

function midPoint(a: Node, b: Node) {
  return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
}

// 计算二次贝塞尔曲线的控制点，使连线向垂直方向偏移
function curveControl(a: Node, b: Node, direction: 'up' | 'down') {
  const m = midPoint(a, b);
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.sqrt(dx * dx + dy * dy) || 1;
  // 垂直单位向量
  const nx = -dy / len;
  const ny = dx / len;
  const offset = 40 * (direction === 'up' ? -1 : 1);
  return { x: m.x + nx * offset, y: m.y + ny * offset };
}
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  xmlns="http://www.w3.org/2000/svg"
  class="relation-diagram"
  aria-label="关系图"
>
  <defs>
    <marker
      id="rd-arrowhead"
      markerWidth="10"
      markerHeight="7"
      refX="9"
      refY="3.5"
      orient="auto"
    >
      <polygon points="0 0, 10 3.5, 0 7" fill="var(--sl-color-text-accent)" />
    </marker>
    <filter id="rd-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="var(--sl-color-black)" flood-opacity="0.25" />
    </filter>
  </defs>

  <!-- 连线层 -->
  {
    edges.map((edge) => {
      const a = getNodeById(edge.from);
      const b = getNodeById(edge.to);
      const m = midPoint(a, b);
      const hasCurve = edge.curve === 'up' || edge.curve === 'down';
      const cp = hasCurve ? curveControl(a, b, edge.curve!) : null;
      const pathD = hasCurve && cp
        ? `M ${a.x} ${a.y} Q ${cp.x} ${cp.y} ${b.x} ${b.y}`
        : null;
      // 标签放在中点（曲线时沿曲线中点稍偏移）
      const labelPos = hasCurve && cp
        ? { x: (a.x + 2 * cp.x + b.x) / 4, y: (a.y + 2 * cp.y + b.y) / 4 }
        : m;

      return (
        <g class="rd-edge">
          {hasCurve && pathD ? (
            <path
              d={pathD}
              stroke="var(--sl-color-gray-4)"
              stroke-width="2"
              stroke-linecap="round"
              fill="none"
              stroke-dasharray={edge.dashed ? "8,5" : undefined}
            />
          ) : (
            <line
              x1={a.x}
              y1={a.y}
              x2={b.x}
              y2={b.y}
              stroke="var(--sl-color-gray-4)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-dasharray={edge.dashed ? "8,5" : undefined}
            />
          )}
          {edge.label && (
            <g>
              <rect
                x={labelPos.x - edge.label.length * 6 - 4}
                y={labelPos.y - 11}
                width={edge.label.length * 12 + 8}
                height="22"
                rx="11"
                fill="var(--sl-color-bg)"
                stroke="var(--sl-color-gray-3)"
                stroke-width="1"
              />
              <text
                x={labelPos.x}
                y={labelPos.y + 4}
                text-anchor="middle"
                fill="var(--sl-color-text)"
                font-size="12"
                font-weight="500"
              >
                {edge.label}
              </text>
            </g>
          )}
        </g>
      );
    })
  }

  <!-- 箭头层 -->
  {
    arrows.map((arrow) => (
      <g class="rd-arrow">
        <line
          x1={arrow.fromX}
          y1={arrow.fromY}
          x2={arrow.toX}
          y2={arrow.toY}
          stroke="var(--sl-color-text-accent)"
          stroke-width="2"
          marker-end="url(#rd-arrowhead)"
          stroke-linecap="round"
        />
        {arrow.label && (
          <text
            x={arrow.fromX}
            y={arrow.fromY - 8}
            text-anchor="middle"
            fill="var(--sl-color-text-accent)"
            font-size="12"
            font-weight="600"
          >
            {arrow.label}
          </text>
        )}
      </g>
    ))
  }

  <!-- 节点层 -->
  {
    nodes.map((node) => (
      <g class="rd-node" filter="url(#rd-shadow)">
        <circle
          cx={node.x}
          cy={node.y}
          r="30"
          fill="var(--sl-color-bg)"
          stroke="var(--sl-color-text-accent)"
          stroke-width="2.5"
        />
        <text
          x={node.x}
          y={node.y + 1}
          text-anchor="middle"
          dominant-baseline="middle"
          fill="var(--sl-color-text)"
          font-size="14"
          font-weight="700"
        >
          {node.label}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .relation-diagram {
    width: 100%;
    max-width: 560px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .rd-node {
    cursor: default;
    transition: opacity 0.2s ease;
  }

  .rd-edge line,
  .rd-edge path {
    transition: stroke 0.2s ease;
  }
</style>
