---
// Generated by Antigravity - Custom Diagram Wrapper Component
---
<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(145deg, #f4f7fc 0%, #eef2f6 100%);
            font-family: 'Noto Sans SC', 'Inter', system-ui, -apple-system, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 2.5rem 1.5rem;
            margin: 0;
        }
        /* 主卡片容器 —— 模拟优雅流程图 */
        .flowchart {
            max-width: 780px;
            width: 100%;
            background: rgba(255,255,255,0.7);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            background: #ffffff;
            border-radius: 3.5rem;
            box-shadow: 
                0 30px 55px rgba(0, 20, 40, 0.12),
                0 12px 24px rgba(0, 0, 0, 0.05),
                inset 0 1px 0 rgba(255,255,255,0.8);
            padding: 2.5rem 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.2rem;
            border: 1px solid rgba(255,255,255,0.6);
        }
        /* 节点通用设计 */
        .node {
            background: white;
            border-radius: 2.5rem;
            padding: 1.2rem 2rem;
            margin: 0.25rem 0;
            width: fit-content;
            min-width: 260px;
            max-width: 100%;
            text-align: center;
            font-weight: 500;
            letter-spacing: 0.02em;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.04), 0 2px 6px rgba(0,0,0,0.02);
            transition: all 0.25s ease;
            border: 1px solid rgba(0,0,0,0.04);
            background: #ffffff;
            position: relative;
            backdrop-filter: blur(4px);
        }
        .node:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 30px rgba(0, 0, 0, 0.08), 0 4px 12px rgba(0,0,0,0.04);
            border-color: rgba(0,80,150,0.12);
        }
        /* 起始节点 (基础行为) */
        .start-node {
            background: #1e293b;
            color: white;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.03em;
            padding: 1.3rem 2.8rem;
            border-radius: 3rem;
            box-shadow: 0 16px 28px rgba(15, 23, 42, 0.2);
            border: none;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            margin-bottom: 0.5rem;
        }
        .start-node:hover {
            box-shadow: 0 22px 35px rgba(15, 23, 42, 0.25);
        }
        /* 决策菱形风格 (用圆角矩形模拟, 保留菱形感觉) */
        .decision-node {
            background: #f8fafc;
            border: 2px solid #cbd5e1;
            border-radius: 2.8rem;
            font-weight: 600;
            color: #0f172a;
            background: #ffffff;
            padding: 1.1rem 2.2rem;
            font-size: 1.05rem;
            position: relative;
            box-shadow: 0 6px 18px rgba(0,0,0,0.03);
            border-left: 6px solid #3b82f6;
            transition: 0.2s;
            margin: 0.6rem 0;
        }
        .decision-node:hover {
            border-left: 8px solid #2563eb;
            background: #f9fbfd;
        }
        /* 结果节点 —— 不同颜色标识 */
        .result-crime {
            background: #dcfce7;
            border: 2px solid #86efac;
            color: #14532d;
            font-weight: 700;
            border-radius: 2.5rem;
            padding: 1.2rem 2.4rem;
            background: linear-gradient(105deg, #f0fdf4 0%, #dcfce7 100%);
            border-left: 8px solid #16a34a;
            box-shadow: 0 8px 16px rgba(22, 163, 74, 0.12);
            font-size: 1.1rem;
        }
        .result-alt {
            background: #fff7ed;
            border: 2px solid #fed7aa;
            color: #7c2d12;
            font-weight: 600;
            border-radius: 2.5rem;
            padding: 1.1rem 2.2rem;
            background: linear-gradient(105deg, #fffbf5 0%, #fff3e4 100%);
            border-left: 8px solid #f97316;
            box-shadow: 0 8px 16px rgba(249, 115, 22, 0.1);
            font-size: 1rem;
        }
        .result-negative {
            background: #f1f5f9;
            border: 2px solid #cbd5e1;
            color: #334155;
            font-weight: 600;
            border-radius: 2.5rem;
            padding: 1rem 2rem;
            background: #f8fafc;
            border-left: 8px solid #64748b;
            box-shadow: 0 6px 14px rgba(100, 116, 139, 0.08);
        }
        /* 连接线区域 */
        .connector {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #475569;
            font-weight: 500;
            font-size: 0.9rem;
            margin: 0.25rem 0;
            width: 100%;
        }
        .arrow-down {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0.25rem 0;
        }
        .line-vertical {
            width: 2.5px;
            height: 28px;
            background: linear-gradient(to bottom, #94a3b8, #64748b);
            border-radius: 4px;
        }
        .arrow-head {
            width: 12px;
            height: 12px;
            border-right: 2.5px solid #475569;
            border-bottom: 2.5px solid #475569;
            transform: rotate(45deg);
            margin-top: -8px;
            background: transparent;
        }
        .branch-container {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            gap: 2.5rem;
            flex-wrap: wrap;
            margin: 0.5rem 0 0.8rem;
            width: 100%;
        }
        .branch-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            min-width: 140px;
            max-width: 240px;
        }
        .branch-label {
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.4rem 1.2rem;
            border-radius: 2rem;
            background: #ffffff;
            border: 1px dashed #94a3b8;
            color: #1e293b;
            margin: 0.3rem 0 0.6rem;
            letter-spacing: 0.4px;
            background: #f1f5f9;
        }
        .branch-label.yes {
            background: #dbeafe;
            border: 1px solid #3b82f6;
            color: #1e3a8a;
        }
        .branch-label.no {
            background: #fee2e2;
            border: 1px solid #ef4444;
            color: #991b1b;
        }
        /* 公式注释 */
        .formula-note {
            margin-top: 1.8rem;
            background: #f0f9ff;
            border-radius: 2rem;
            padding: 1rem 2rem;
            font-size: 0.95rem;
            color: #0c4a6e;
            border: 1px solid #bae6fd;
            background: #f0f9ff;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
            box-shadow: 0 2px 10px rgba(14, 165, 233, 0.1);
        }
        .formula-note strong {
            color: #0284c7;
            font-weight: 700;
            margin: 0 0.2rem;
        }
        hr {
            width: 100%;
            border: 0.5px solid #e2e8f0;
            margin: 0.8rem 0;
        }
        @media (max-width: 550px) {
            .flowchart {
                padding: 1.8rem 1rem;
            }
            .branch-container {
                gap: 1rem;
            }
        }
    </style>

<div class="flowchart">
        <!-- 节点 A: 行为人的基础行为 -->
        <div class="node start-node">
            ⚖️ 行为人的基础行为
        </div>
        <!-- 向下连接 -->
        <div class="arrow-down">
            <div class="line-vertical"></div>
            <div class="arrow-head"></div>
        </div>
        <!-- 决策 B: 行为主体是非国家工作人员? -->
        <div class="node decision-node">
            <span style="font-weight:700; margin-right:6px;">🔍</span> 
            行为主体是<br><strong>非国家工作人员</strong>？
        </div>
        <!-- 分支：是/否 -->
        <div class="branch-container">
            <!-- 否 -> 不构成职务侵占罪，可能构成贪污罪 -->
            <div class="branch-item">
                <span class="branch-label no">❌ 否</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <div class="node result-negative" style="font-size:0.95rem; padding:1rem 1.5rem;">
                    🚫 不构成职务侵占罪<br><span style="font-size:0.85rem; font-weight:400;">可能构成贪污罪</span>
                </div>
            </div>
            <!-- 是 -> 进入下一步判断 -->
            <div class="branch-item">
                <span class="branch-label yes">✅ 是</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <!-- 这里不直接放节点，而是继续向下流程，所以用占位连接表示继续 -->
                <div style="font-size:0.8rem; color:#64748b; margin:0.2rem 0;">⬇️ 继续判断</div>
            </div>
        </div>
        <!-- 统一向下汇聚到下一个决策 (因为是流程主线) -->
        <div style="display:flex; flex-direction:column; align-items:center; width:100%; margin-top:0.2rem;">
            <div class="line-vertical" style="height:24px;"></div>
            <div class="arrow-head"></div>
        </div>
        <!-- 决策 D: 行为对象是本单位财物? -->
        <div class="node decision-node">
            <span style="font-weight:700;">📦</span> 
            行为对象是<br><strong>本单位财物</strong>？
        </div>
        <!-- 分支：否/是 -->
        <div class="branch-container">
            <!-- 否 -> 退回基础罪名 侵占/盗窃/诈骗 -->
            <div class="branch-item">
                <span class="branch-label no">❌ 否</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <div class="node result-alt">
                    🔄 退回基础罪名<br><span style="font-size:0.9rem; font-weight:500;">侵占 / 盗窃 / 诈骗</span>
                </div>
            </div>
            <!-- 是 -> 继续 -->
            <div class="branch-item">
                <span class="branch-label yes">✅ 是</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <div style="font-size:0.8rem; color:#64748b;">⬇️ 下一步</div>
            </div>
        </div>
        <!-- 向下连接至决策F -->
        <div style="display:flex; flex-direction:column; align-items:center; width:100%; margin-top:0.2rem;">
            <div class="line-vertical" style="height:24px;"></div>
            <div class="arrow-head"></div>
        </div>
        <!-- 决策 F: 利用职务便利? -->
        <div class="node decision-node">
            <span style="font-weight:700;">🔑</span> 
            利用<strong>职务便利</strong>？
        </div>
        <!-- 分支：否/是 -->
        <div class="branch-container">
            <!-- 否 -> 退回基础罪名 (侵占/盗窃/诈骗) 同样路径 -->
            <div class="branch-item">
                <span class="branch-label no">❌ 否</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <div class="node result-alt">
                    🔄 退回基础罪名<br><span style="font-size:0.9rem;">侵占 / 盗窃 / 诈骗</span>
                </div>
            </div>
            <!-- 是 -> 职务侵占罪成立！ -->
            <div class="branch-item">
                <span class="branch-label yes">✅ 是</span>
                <div class="arrow-down" style="margin:0.1rem 0;">
                    <div class="line-vertical" style="height:20px;"></div>
                </div>
                <div class="node result-crime">
                    ⚡ 职务侵占罪成立<br>
                    <span style="font-size:0.9rem; font-weight:500; display:block; margin-top:4px;">
                        = A + B₁ + B₂ + B₃
                    </span>
                </div>
            </div>
        </div>
        <!-- 装饰分割线与公式注释 -->
        <hr>
        <div class="formula-note">
            <span>📐</span> 
            <span><strong>职务侵占罪</strong> = 基础行为 (A) + 非国家工作人员 (B₁) + 本单位财物 (B₂) + 利用职务便利 (B₃)</span>
        </div>
        <!-- 底部微小提示（保持设计完整性） -->
        <div style="margin-top: 0.8rem; font-size: 0.75rem; color: #64748b; letter-spacing: 0.3px;">
            逻辑判断流程 · 依据刑法第二百七十一条
        </div>
    </div>


