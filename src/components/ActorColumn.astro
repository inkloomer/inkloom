---
// src/components/ActorColumn.astro
interface Props {
  actor: '甲' | '乙' | '丙';
  title: string;
}
const { actor, title } = Astro.props;
const colorMap = {
  甲: { border: 'rgba(59, 130, 246, 0.3)', dot: '#3b82f6', bg: 'rgba(59, 130, 246, 0.04)' },
  乙: { border: 'rgba(168, 85, 247, 0.3)', dot: '#a855f7', bg: 'rgba(168, 85, 247, 0.04)' },
  丙: { border: 'rgba(34, 197, 94, 0.3)', dot: '#22c55e', bg: 'rgba(34, 197, 94, 0.04)' }
};
const colors = colorMap[actor] || colorMap['甲'];
---
<div class="actor-analysis-column" data-actor={actor} style={`--actor-border-color: ${colors.border}; --actor-glow-bg: ${colors.bg};`}>
  <div class="actor-column-header">
    <span class="actor-header-dot" style={`background-color: ${colors.dot};`}></span>
    <span class="actor-header-text">{actor}</span>
    <span class="actor-header-title">{title}</span>
  </div>
  <div class="actor-column-content">
    <slot />
  </div>
</div>

<style is:global>
  /* ==================== ACTOR COLUMN LIQUID GLASS CAPSULE ==================== */
  .actor-analysis-column {
    display: flex !important;
    flex-direction: column !important;
    background: var(--toc-glass-bg) !important;
    border: 1px solid var(--toc-glass-border) !important;
    border-radius: 20px !important;
    padding: 16px !important;
    box-shadow: var(--toc-shadow) !important;
    box-sizing: border-box !important;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    position: relative !important;
  }

  /* Liquid Capsule Border Hover */
  .actor-analysis-column:hover {
    transform: translateY(-4px) !important;
    border-color: var(--actor-border-color) !important;
    background: var(--toc-glass-bg-hover) !important;
    box-shadow: 
      inset 0 1px 2px rgba(255, 255, 255, 0.4),
      inset 0 8px 12px var(--actor-glow-bg),
      0 12px 28px -8px rgba(0, 0, 0, 0.5) !important;
  }

  .actor-column-header {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    color: var(--sl-color-text) !important;
    border-bottom: 1px dashed var(--sl-color-hairline) !important;
    padding-bottom: 8px !important;
    margin-bottom: 12px !important;
  }

  .actor-header-dot {
    width: 6px !important;
    height: 6px !important;
    border-radius: 50% !important;
    display: inline-block !important;
    box-shadow: 0 0 6px currentColor !important;
  }

  .actor-header-text {
    font-size: 15px !important;
    font-weight: 800 !important;
  }

  .actor-header-title {
    font-size: 11px !important;
    color: var(--sl-color-text-muted) !important;
    font-weight: 500 !important;
  }

  .actor-column-content {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
  }
</style>
