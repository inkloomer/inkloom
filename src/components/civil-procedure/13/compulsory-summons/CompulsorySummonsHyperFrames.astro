---
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const source = `${assetBase}animations/compulsory-summons/hyperframes.html?autoplay=1&loop=1`;
---

<div class="hyperframes-viewport" data-animation-viewport>
  <iframe
    src={source}
    title="拘传适用判断 HyperFrames 动画"
    loading="eager"
    allow="autoplay; fullscreen"
    allowfullscreen
  ></iframe>
</div>

<style>
  .hyperframes-viewport {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    background: #f7f8f5;
  }

  .hyperframes-viewport iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
