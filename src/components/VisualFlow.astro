---
// src/components/VisualFlow.astro
interface Props {
  amountA?: string;
  action: string;
  relationInfo?: string;
}
const { amountA = '送100万', action, relationInfo = '意思联络' } = Astro.props;
---

<div class="visual-flow-wrapper">
  <div class="visual-flow-grid">
    <!-- Actor A (Jia) -->
    <div class="flow-actor-node-wrapper" data-actor="甲">
      <div class="flow-actor-bubble bubble-甲">甲</div>
      <div class="flow-actor-label">行贿人</div>
      <div class="flow-vertical-thread"></div>
    </div>
    
    <!-- Link 1 (Jia to Yi) -->
    <div class="flow-link-column link-1">
      <div class="flow-link-amount text-gold">{amountA}</div>
      <div class="flow-link-line-container">
        <svg class="flow-link-svg">
          <line x1="0" y1="3" x2="100%" y2="3" class="bg-line" />
          <line x1="0" y1="3" x2="100%" y2="3" class="flowing-line flow-link-1" />
        </svg>
        <div class="flow-arrow arrow-1"></div>
      </div>
      <div class="flow-link-caption">概括故意</div>
    </div>
    
    <!-- Actor B (Yi) -->
    <div class="flow-actor-node-wrapper" data-actor="乙">
      <div class="flow-actor-bubble bubble-乙">乙</div>
      <div class="flow-actor-label">中介人</div>
      <div class="flow-vertical-thread"></div>
    </div>
    
    <!-- Link 2 (Yi to Bing) -->
    <div class="flow-link-column link-2">
      <div class="flow-link-amount text-indigo">{action}</div>
      <div class="flow-link-line-container">
        <svg class="flow-link-svg">
          <line x1="0" y1="3" x2="100%" y2="3" class="bg-line" />
          <line x1="0" y1="3" x2="100%" y2="3" class="flowing-line flow-link-2" />
        </svg>
        <div class="flow-arrow arrow-2"></div>
      </div>
      <div class="flow-link-caption">{relationInfo}</div>
    </div>
    
    <!-- Actor C (Bing) -->
    <div class="flow-actor-node-wrapper" data-actor="丙">
      <div class="flow-actor-bubble bubble-丙">丙</div>
      <div class="flow-actor-label">受贿人</div>
      <div class="flow-vertical-thread"></div>
    </div>
  </div>
</div>

<style is:global>
  /* ==================== MINIMALIST INTEGRATED FLOW DESIGN ==================== */
  
  .visual-flow-wrapper {
    margin-top: 12px;
    margin-bottom: 0px;
    padding: 0;
  }

  /* 5-Column Grid Layout for Desktop alignment */
  @media (min-width: 60rem) {
    .visual-flow-grid {
      display: grid !important;
      grid-template-columns: 1fr 120px 1.2fr 120px 1fr !important;
      align-items: center !important;
      gap: 0 !important;
    }
  }

  @media (max-width: 59.999rem) {
    .visual-flow-grid {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 4px !important;
      padding: 8px 12px !important;
      background: var(--sl-color-bg-sidebar) !important;
      border: 1px solid var(--sl-color-hairline) !important;
      border-radius: 8px !important;
    }
  }

  /* --- Actor Node Bubble --- */
  .flow-actor-node-wrapper {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    position: relative !important;
    text-align: center !important;
  }

  .flow-actor-bubble {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    transition: all 0.2s ease !important;
    user-select: none !important;
  }

  /* Sleek flat semi-translucent themes for nodes in dark mode */
  .bubble-甲 {
    background-color: rgba(59, 130, 246, 0.1) !important;
    color: #60a5fa !important;
    border: 1px solid rgba(59, 130, 246, 0.4) !important;
  }
  .bubble-乙 {
    background-color: rgba(168, 85, 247, 0.1) !important;
    color: #c084fc !important;
    border: 1px solid rgba(168, 85, 247, 0.4) !important;
  }
  .bubble-丙 {
    background-color: rgba(34, 197, 94, 0.1) !important;
    color: #34d399 !important;
    border: 1px solid rgba(34, 197, 94, 0.4) !important;
  }

  /* Light Theme overrides for nodes */
  [data-theme="light"] .bubble-甲 {
    background-color: #eff6ff !important;
    color: #1d4ed8 !important;
    border: 1px solid #bfdbfe !important;
  }
  [data-theme="light"] .bubble-乙 {
    background-color: #f5f3ff !important;
    color: #6d28d9 !important;
    border: 1px solid #ddd6fe !important;
  }
  [data-theme="light"] .bubble-丙 {
    background-color: #ecfdf5 !important;
    color: #047857 !important;
    border: 1px solid #a7f3d0 !important;
  }

  .flow-actor-node-wrapper:hover .flow-actor-bubble {
    transform: scale(1.05) !important;
  }

  .flow-actor-label {
    font-size: 11px !important;
    font-weight: 500 !important;
    margin-top: 4px !important;
    color: var(--sl-color-text-muted) !important;
  }

  /* --- Simple Clean Vertical Connection Lines (Desktop Only) --- */
  @media (min-width: 60rem) {
    .flow-vertical-thread {
      width: 1px !important;
      height: 24px !important;
      background-color: var(--sl-color-hairline) !important;
      margin-top: 4px !important;
    }
  }

  @media (max-width: 59.999rem) {
    .flow-vertical-thread {
      display: none !important;
    }
  }

  /* --- Flow Links / Arrows --- */
  .flow-link-column {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    position: relative !important;
  }

  @media (max-width: 59.999rem) {
    .flow-link-column {
      flex-grow: 1 !important;
      min-width: 40px !important;
    }
  }

  .flow-link-amount {
    font-size: 11px !important;
    font-weight: 600 !important;
    margin-bottom: 2px !important;
  }
  .text-gold { color: #d97706 !important; }
  .text-indigo { color: #4f46e5 !important; }

  /* Light Theme Adjustments for Link colors */
  [data-theme="light"] .text-gold { color: #b45309 !important; }
  [data-theme="light"] .text-indigo { color: #4338ca !important; }

  .flow-link-line-container {
    position: relative !important;
    width: 100% !important;
    height: 8px !important;
    display: flex !important;
    align-items: center !important;
  }

  .flow-link-svg {
    width: 100% !important;
    height: 4px !important;
    display: block !important;
    overflow: visible !important;
  }

  .flow-link-svg line.bg-line {
    stroke: var(--sl-color-hairline) !important;
    stroke-width: 2 !important;
  }

  .flow-link-svg line.flowing-line {
    stroke-width: 2 !important;
  }

  /* Simple colors */
  .flow-link-1 { stroke: #d97706 !important; }
  .flow-link-2 { stroke: #4f46e5 !important; }

  .flow-arrow {
    position: absolute !important;
    right: -2px !important;
    top: -1px !important;
    width: 0 !important;
    height: 0 !important;
    border-top: 4px solid transparent !important;
    border-bottom: 4px solid transparent !important;
  }
  .arrow-1 { border-left: 6px solid #d97706 !important; }
  .arrow-2 { border-left: 6px solid #4f46e5 !important; }

  .flow-link-caption {
    font-size: 9px !important;
    color: var(--sl-color-text-muted) !important;
    margin-top: 2px !important;
    white-space: nowrap !important;
  }

  @media (max-width: 59.999rem) {
    .flow-link-caption {
      display: none !important;
    }
  }
</style>
